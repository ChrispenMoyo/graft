# GRAFT Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
API_BASE_URL=https://api.graft.co.zw/v1

# Environment
# Options: development, staging, production
ENVIRONMENT=development

# Phone Number Country Code (Zimbabwe)
# Do not change - GRAFT is Zimbabwe-specific
COUNTRY_CODE=+263

# Default Currency (USD or ZWL)
DEFAULT_CURRENCY=USD

# App Version
APP_VERSION=1.0.0